# ============================================================
# Kilas Bot — Template Environment Variables
# Salin file ini: cp .env.example .env
# Lalu isi nilainya. JANGAN commit file .env!
# ============================================================

# Token bot Telegram dari @BotFather (WAJIB)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Provider LLM: groq | gemini | claude (default: groq)
LLM_PROVIDER=groq

# API key untuk provider yang dipilih di atas (WAJIB untuk fitur ringkasan)
LLM_API_KEY=your_llm_api_key_here

# Model opsional per provider (hilangkan tanda # jika ingin mengubah default):
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_MODEL=gemini-1.5-flash
# CLAUDE_MODEL=claude-3-haiku-20240307

# Timeout pemanggilan LLM dalam detik (default: 30)
# LLM_TIMEOUT=30
